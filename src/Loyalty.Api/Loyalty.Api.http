@host = http://localhost:5105
@key = dev-loyalty-key
@member = 11111111-1111-1111-1111-111111111111
@campaign = cccccccc-cccc-cccc-cccc-cccccccccccc

### Seed or replay synthetic data
POST {{host}}/api/dev/seed
X-Api-Key: {{key}}

### Read member
GET {{host}}/api/members/{{member}}
X-Api-Key: {{key}}

### Purchase upgrade with the current UTC occurrence
POST {{host}}/api/events
X-Api-Key: {{key}}
Content-Type: application/json

{"eventId":"walkthrough-purchase-1","memberId":"{{member}}","type":"Purchase","category":"electronics","amount":6000,"occurredAt":"{{$datetime iso8601}}"}

### Partial refund
POST {{host}}/api/events
X-Api-Key: {{key}}
Content-Type: application/json

{"eventId":"walkthrough-refund-1","memberId":"{{member}}","type":"Refund","category":"electronics","amount":1000,"occurredAt":"{{$datetime iso8601}}","originalEventId":"walkthrough-purchase-1"}

### Claim
POST {{host}}/api/members/{{member}}/cashback/claim
X-Api-Key: {{key}}
Idempotency-Key: walkthrough-claim-1

### Replay returns the same body and Idempotent-Replay: true
POST {{host}}/api/members/{{member}}/cashback/claim
X-Api-Key: {{key}}
Idempotency-Key: walkthrough-claim-1

### Leaderboard
GET {{host}}/api/campaigns/{{campaign}}/leaderboard?top=10
X-Api-Key: {{key}}

### Issue coupons (safe to resend)
POST {{host}}/api/coupon-batches
X-Api-Key: {{key}}
Content-Type: application/json

{"templateId":"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaa1","target":{"memberIds":["{{member}}"],"batchId":"bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"}}

### Read available coupon IDs
GET {{host}}/api/members/{{member}}/coupons?status=Available
X-Api-Key: {{key}}

### Replace couponId with the ID returned above
@couponId = 00000000-0000-0000-0000-000000000000
POST {{host}}/api/members/{{member}}/coupons/{{couponId}}/redeem
X-Api-Key: {{key}}
Content-Type: application/json

{"orderAmount":100,"orderRef":"sample-order-1"}

### Review tiers
POST {{host}}/api/admin/tier-review/run
X-Api-Key: {{key}}

### Read ledger
GET {{host}}/api/members/{{member}}/ledger?page=1
X-Api-Key: {{key}}

### Public health
GET {{host}}/health
