{
  "ConnectionStrings": {
    "Loyalty": "Data Source=appdata/loyalty-engine.db",
    "Redis": ""
  },
  "Security": {
    "ApiKey": ""
  },
  "Loyalty": {
    "Currency": "USD",
    "RollingWindowDays": 30,
    "DowngradeGraceDays": 14,
    "EnableTierReviewWorker": true,
    "Tiers": {
      "Bronze": 0,
      "Silver": 1000,
      "Gold": 5000,
      "Platinum": 20000
    },
    "CashbackRates": {
