      "Silver": {
        "*": 0.0075
      },
      "Gold": {
        "*": 0.01,
        "electronics": 0.015
      },
      "Platinum": {
        "*": 0.02,
        "electronics": 0.025
      }
    },
    "DailyClaimCap": {
      "Bronze": 20,
      "Silver": 50,
      "Gold": 150,
      "Platinum": 500
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
